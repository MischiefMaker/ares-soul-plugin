{{#if this.isSelf}}
  <section class="soul-xp">
    <h3>Experience</h3>
    {{#if this.isLoading}}
      <div class="text-muted">Loading XP…</div>
    {{else}}
      <div class="row g-2 mb-3">
        <div class="col"><div class="card card-body">Available: {{this.xp.available}}</div></div>
        <div class="col"><div class="card card-body">Earned: {{this.xp.earned}}</div></div>
        <div class="col"><div class="card card-body">Spent: {{this.xp.spent}}</div></div>
        <div class="col"><div class="card card-body">Catch-up: {{this.xp.catchup}}</div></div>
      </div>

      <div class="card card-body mb-3">
        <h4>Advance a Skill or Aspect</h4>
        <div class="row g-3 align-items-end">
          <div class="col-md-3">
            <label for="soul-xp-trait-type" class="form-label">Trait Type</label>
            <select
              id="soul-xp-trait-type"
              class="form-select"
              onchange={{action "selectTraitType" value="target.value"}}
            >
              <option value="skill">Skill</option>
              <option value="aspect">Aspect</option>
            </select>
          </div>
          <div class="col-md-4">
            <label for="soul-xp-trait" class="form-label">Trait</label>
            <select
              id="soul-xp-trait"
              class="form-select"
              onchange={{action "selectTrait" value="target.value"}}
            >
              <option value="">Choose a Trait</option>
              {{#if (eq this.selectedTraitType "aspect")}}
                {{#each this.aspects as |aspect|}}
                  <option value={{aspect.key}}>{{aspect.name}} — current rating {{aspect.rating}}</option>
                {{/each}}
              {{else}}
                {{#each this.skills as |skill|}}
                  <option value={{skill.key}}>{{skill.name}} — current rating {{skill.rating}}</option>
                {{/each}}
              {{/if}}
            </select>
          </div>
          <div class="col-md-2">
            <button
              type="button"
              class="btn btn-primary w-100"
              disabled={{not this.selectedTrait}}
              onclick={{action "previewSpend" this.selectedTraitType this.selectedTrait}}
            >
              Preview
            </button>
          </div>
        </div>

        {{#if this.spendError}}
          <div class="alert alert-danger mt-3 mb-0">{{this.spendError}}</div>
        {{/if}}

        {{#if this.spendPreview}}
          <div class="border-start border-3 ps-3 mt-3">
            <p>
              This increases
              <strong>{{this.spendPreview.trait_name}}</strong>
              to rating <strong>{{this.spendPreview.target_rating}}</strong>
              for <strong>{{this.spendPreview.cost}} XP</strong>.
            </p>
            <button
              type="button"
              class="btn btn-primary"
              onclick={{action
                "confirmSpend"
                this.spendPreview.trait_type
                this.spendPreview.trait_key
                this.spendPreviewAmount
              }}
            >
              Confirm Spend
            </button>
          </div>
        {{/if}}
      </div>

      <h4>Recent XP History</h4>
      <ul class="list-group soul-xp-history">
        {{#each this.xp.history as |entry|}}
          <li class="list-group-item">{{entry.base_amount}} XP {{entry.directionLabel}} — {{entry.sourceLabel}}</li>
        {{/each}}
      </ul>
    {{/if}}
  </section>
{{/if}}
