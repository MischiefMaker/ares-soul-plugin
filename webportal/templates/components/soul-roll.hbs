<li class="soul-roll-nav-item">
  <button type="button" class="dropdown-item" onclick={{action "openRoll"}}>
    SOUL Roll
  </button>
</li>

{{#if this.canReview}}
  <li class="soul-roll-review-nav-item">
    <button type="button" class="dropdown-item" onclick={{action "openGmReview"}}>
      Review SOUL Rolls
    </button>
  </li>
{{/if}}

<BsModalSimple
  @title="SOUL Roll"
  @closeTitle="Close"
  @submitTitle={{null}}
  @size="lg"
  @fade={{true}}
  @open={{this.rollOpen}}
  @onHide={{action "closeRoll"}}
>
  {{#if this.isLoading}}
    <p>Loading SOUL roll…</p>
  {{else if (eq this.rollStage "setup")}}
    <p>Select the ability and difficulty for this roll.</p>

    <div class="row g-2 mb-3">
      <div class="col-6">
        <label class="form-label">Skill</label>
        <PowerSelect
          @selected={{this.selectedSkill}}
          @options={{this.skills}}
          @searchField="name"
          @onChange={{action "selectSkill"}}
          as |skill|
        >
          {{skill.name}} ({{skill.rating}})
        </PowerSelect>
      </div>

      <div class="col-6">
        <label class="form-label">Difficulty</label>
        <PowerSelect
          @selected={{this.selectedDifficulty}}
          @options={{this.difficulties}}
          @searchField="name"
          @onChange={{action "selectDifficulty"}}
          as |difficulty|
        >
          {{difficulty.name}}
        </PowerSelect>
      </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <button
        type="button"
        class="btn btn-primary"
        onclick={{action "startRoll" false}}
      >
        Start Standard Roll
      </button>
      <button
        type="button"
        class="btn btn-secondary"
        onclick={{action "startRoll" true}}
      >
        Request GM Assistance
      </button>
    </div>
  {{else if (eq this.rollStage "awaiting_gm")}}
    <h4>Waiting for GM Review</h4>
    <p>
      Roll #{{this.pendingRoll.id}} for {{this.pendingRoll.skill_key}} is waiting for
      a scene GM to review its Boons and Banes.
    </p>
    <button
      type="button"
      class="btn btn-primary"
      onclick={{action "refreshPendingRoll"}}
    >
      Refresh
    </button>
    <button
      type="button"
      class="btn btn-secondary"
      onclick={{action "cancelGmRequest"}}
    >
      No GM Available - Proceed Without One
    </button>
    <div class="mt-3">
      <Input @value={{this.abortReason}} class="form-control mb-2" placeholder="Reason for aborting" />
      <button type="button" class="btn btn-danger" onclick={{action "abortRoll" this.pendingRoll}}>
        Abort This Roll
      </button>
    </div>
  {{else if (eq this.rollStage "selection")}}
    <h4>Choose Boons and Banes</h4>
    {{#if this.candidates}}
      <p>
        Checked optional entries will be included. Mandatory entries were
        selected by the GM and are always applied.
      </p>
      <div class="list-group mb-3">
        {{#each this.candidates as |candidate|}}
          <label class="list-group-item">
            <input
              type="checkbox"
              class="form-check-input me-2"
              checked={{candidate.selected}}
              disabled={{candidate.mandatory}}
              onchange={{action "togglePlayerCandidate" candidate}}
            >
            <strong>{{candidate.name}}</strong> [{{candidate.tag}}]
            — {{candidate.level_state}}
            {{#if candidate.modifier}}
              ({{candidate.modifier}})
            {{/if}}
            {{#if candidate.mandatory}}
              <span class="badge bg-secondary">Mandatory</span>
            {{/if}}
          </label>
        {{/each}}
      </div>
      <div class="d-flex gap-2 mb-3">
        <button
          type="button"
          class="btn btn-secondary"
          onclick={{action "selectAllCandidates"}}
        >
          Select All Suggested
        </button>
        <button
          type="button"
          class="btn btn-secondary"
          onclick={{action "clearOptionalCandidates"}}
        >
          Clear Optional
        </button>
      </div>
    {{else}}
      <p>No matching Boons or Banes were suggested.</p>
    {{/if}}

    {{#if this.manualOptions.length}}
      <div class="mb-3">
        <label class="form-label">Other applicable Boons/Banes</label>
        <PowerSelectMultiple
          @selected={{this.selectedManualEntries}}
          @options={{this.manualOptions}}
          @searchField="name"
          @searchEnabled=true
          @placeholder="Not suggested, but applies..."
          @onChange={{action "selectManualEntries"}}
          as |entry|
        >
          {{entry.name}} [{{entry.tag}}]
        </PowerSelectMultiple>
      </div>
    {{/if}}

    <button
      type="button"
      class="btn btn-primary"
      onclick={{action "resolvePlayerSelection"}}
    >
      Confirm and Roll
    </button>
  {{else if (eq this.rollStage "result")}}
    <h4>Private Roll Result</h4>
    <dl class="row">
      <dt class="col-sm-4">Skill</dt>
      <dd class="col-sm-8">{{this.rollResult.skill_key}}</dd>
      <dt class="col-sm-4">Final result</dt>
      <dd class="col-sm-8">{{this.rollResult.final_result}}</dd>
      <dt class="col-sm-4">Degree</dt>
      <dd class="col-sm-8">{{this.rollResult.degree_of_success}}</dd>
      <dt class="col-sm-4">Difficulty</dt>
      <dd class="col-sm-8">{{this.rollResult.difficulty}}</dd>
      {{#if (eq this.rollResult.extraordinary "true")}}
        <dt class="col-sm-4">Extraordinary</dt>
        <dd class="col-sm-8">Yes</dd>
      {{/if}}
    </dl>

    {{#if this.rollResult.applied_modifiers}}
      <h5>Applied Boons and Banes</h5>
      <ul>
        {{#each this.rollResult.applied_modifiers as |modifier|}}
          <li>
            {{modifier.name}} [{{modifier.tag}}] —
            {{modifier.level_state}} ({{modifier.modifier}})
          </li>
        {{/each}}
      </ul>
    {{/if}}

    <p>
      This result has not been posted to the scene. Pose or describe it
      yourself if you want the other participants to see it.
    </p>
    <button type="button" class="btn btn-secondary" onclick={{action "newRoll"}}>
      Start Another Roll
    </button>
  {{/if}}

  {{#if this.pendingRolls.length}}
    <hr>
    <h4>Open Pending Rolls</h4>
    {{#each this.pendingRolls as |pending|}}
      <div class="d-flex justify-content-between align-items-center mb-2">
        <button type="button" class="btn btn-link" onclick={{action "showPendingRoll" pending}}>
          #{{pending.id}} {{pending.skill_key}} — {{pending.status}}
        </button>
        <button type="button" class="btn btn-sm btn-outline-danger"
          onclick={{action "abortRoll" pending}}>Abort</button>
      </div>
    {{/each}}
    <Input @value={{this.abortReason}} class="form-control mb-3" placeholder="Required abort reason" />
  {{/if}}

  <hr>
  <h4>Recent Rolls</h4>
  <ul class="list-group">
    {{#each this.rollHistory as |roll|}}
      <li class="list-group-item">#{{roll.id}} {{roll.skill_key}}:
        {{roll.final_result}} — {{roll.degree_of_success}}</li>
    {{/each}}
  </ul>
</BsModalSimple>

{{#if this.canReview}}
  <BsModalSimple
    @title="Review SOUL Rolls"
    @closeTitle="Close"
    @submitTitle={{null}}
    @size="lg"
    @fade={{true}}
    @open={{this.gmReviewOpen}}
    @onHide={{action "closeGmReview"}}
  >
    {{#if this.gmIsLoading}}
      <p>Loading pending rolls…</p>
    {{else if (eq this.gmReviewStage "list")}}
      <div class="card card-body mb-3">
        <h4>Force-Abort Any Open Roll</h4>
        <p>Use the pending roll ID and provide the required audit reason.</p>
        <div class="row g-2">
          <div class="col-md-3">
            <Input @type="number" @value={{this.forceAbortRollId}} class="form-control"
              placeholder="Roll ID" />
          </div>
          <div class="col-md-7">
            <Input @value={{this.forceAbortReason}} class="form-control"
              placeholder="Required reason" />
          </div>
          <div class="col-md-2">
            <button type="button" class="btn btn-danger w-100"
              onclick={{action "forceAbortById"}}>Force Abort</button>
          </div>
        </div>
      </div>
      {{#if this.gmPendingRolls}}
        <div class="list-group">
          {{#each this.gmPendingRolls as |pending|}}
            <button
              type="button"
              class="list-group-item list-group-item-action"
              onclick={{action "loadGmCandidates" pending}}
            >
              Roll #{{pending.id}} — {{pending.character}} —
              {{pending.skill_key}}
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger ms-2"
              onclick={{action "forceAbortRoll" pending}}>Force Abort</button>
          {{/each}}
        </div>
      {{else}}
        <p>No GM-assisted SOUL rolls are waiting in this scene.</p>
      {{/if}}
    {{else if (eq this.gmReviewStage "candidates")}}
      <h4>
        Roll #{{this.selectedGmRoll.id}} — {{this.selectedGmRoll.character}} —
        {{this.selectedGmRoll.skill_key}}
      </h4>
      <p>
        Mark each candidate mandatory, optional, or leave both boxes clear
        to exclude it.
      </p>

      {{#if this.gmCandidates}}
        <div class="list-group mb-3">
          {{#each this.gmCandidates as |candidate|}}
            <div class="list-group-item">
              <div>
                <strong>{{candidate.name}}</strong> [{{candidate.tag}}]
              </div>
              {{#if candidate.public_description}}
                <p>{{candidate.public_description}}</p>
              {{/if}}
              {{#if candidate.mechanical_effect}}
                <p>Mechanical effect: {{candidate.mechanical_effect}}</p>
              {{/if}}
              {{#if candidate.character_explanation}}
                <p>Character explanation: {{candidate.character_explanation}}</p>
              {{/if}}
              {{#if candidate.gm_notes}}
                <p>GM notes: {{candidate.gm_notes}}</p>
              {{/if}}
              <label class="me-3">
                <input
                  type="checkbox"
                  class="form-check-input me-1"
                  checked={{candidate.mandatory}}
                  onchange={{action "toggleGmMandatory" candidate}}
                >
                Mandatory
              </label>
              <label>
                <input
                  type="checkbox"
                  class="form-check-input me-1"
                  checked={{candidate.optional}}
                  onchange={{action "toggleGmOptional" candidate}}
                >
                Optional
              </label>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p>No matching Boons or Banes were found for this roll.</p>
      {{/if}}

      <div class="d-flex gap-2">
        <button
          type="button"
          class="btn btn-primary"
          onclick={{action "submitGmSelections"}}
        >
          Submit Selections
        </button>
        <button
          type="button"
          class="btn btn-secondary"
          onclick={{action "backToGmList"}}
        >
          Back
        </button>
      </div>
    {{/if}}
  </BsModalSimple>
{{/if}}
