<section class="soul-culminations">
  <h3>
    Culminations
    <span class="badge rounded-pill bg-secondary ms-1"
      title="A permanent record of a significant story milestone or accomplishment - not an XP purchase or stat bonus. Staff propose a title and description; once approved it becomes a permanent part of your Narrative History.">?</span>
  </h3>
  {{#if this.isLoading}}
    <div class="text-muted">Loading Culminations…</div>
  {{else}}
    {{#each this.entries as |entry|}}
      <article class="card mb-3 soul-culmination">
        <div class="card-body">
          <h5>{{entry.title}} <span class="badge bg-secondary">{{entry.status}}</span></h5>
          <p>{{entry.description}}</p>
        </div>
      </article>
    {{/each}}
  {{/if}}
</section>
