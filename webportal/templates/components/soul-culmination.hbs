<section class="soul-culminations">
  <h3>
    Culminations
    <button type="button" class="badge rounded-pill bg-secondary ms-1 border-0"
      aria-label="What is a Culmination?" onclick={{action "toggleInfo"}}>?</button>
  </h3>
  {{#if this.showInfo}}
    <div class="alert alert-secondary py-2">
      A permanent record of a significant story milestone or accomplishment - not an XP purchase or stat
      bonus. Staff record a title and description, and it becomes a permanent part of your Narrative
      History. (Automated sources, like Inklings, may propose one for staff to review and approve first.)
    </div>
  {{/if}}
  {{#if this.isLoading}}
    <div class="text-muted">Loading Culminations…</div>
  {{else}}
    {{#each this.entries as |entry|}}
      <article class="card mb-3 soul-culmination">
        <div class="card-body">
          <h5>{{entry.title}} <span class="badge bg-secondary">{{entry.status}}</span></h5>
          <p>{{entry.description}}</p>
        </div>
      </article>
    {{/each}}
  {{/if}}
</section>
