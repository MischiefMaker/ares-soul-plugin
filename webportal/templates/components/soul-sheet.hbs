{{#if this.isLoading}}
  <div class="text-muted soul-sheet-loading">Loading SOUL sheet…</div>
{{else if this.sheet.error}}
  <div class="alert alert-danger soul-sheet-error">{{this.sheet.error}}</div>
{{else}}
  <section class="soul-sheet">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h3 class="mb-0">{{this.sheet.character}}</h3>
      <div class="d-flex gap-2 flex-wrap">
        <span class="badge bg-primary">Resonance {{this.sheet.resonance_label}}</span>
        <span class="badge bg-secondary">XP {{this.sheet.xp.available}}</span>
        <span class="badge bg-light text-dark">{{this.sheet.xp.earned}} earned</span>
        <span class="badge bg-light text-dark">{{this.sheet.xp.spent}} spent</span>
      </div>
    </div>

    <div class="row">
      {{#each this.sheet.aspects as |aspect|}}
        <div class="col-lg-4 col-md-6 mb-3">
          <div class="card h-100 soul-sheet-aspect">
            <div class="card-header d-flex justify-content-between align-items-center">
              <strong>{{aspect.name}}</strong>
              <span class="badge bg-primary">{{aspect.rating}}</span>
            </div>
            <div class="table-responsive">
              <table class="table table-sm mb-0">
                <thead>
                  <tr>
                    <th scope="col">Skill</th>
                    <th scope="col" class="text-center">Rating</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each aspect.skills as |skill|}}
                    <tr>
                      <td>{{skill.name}}</td>
                      <td class="text-center"><strong>{{skill.rating}}</strong></td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      {{/each}}
    </div>

  </section>
{{/if}}
