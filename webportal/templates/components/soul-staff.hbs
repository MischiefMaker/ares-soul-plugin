<section class="soul-staff card card-body mt-4">
  <h3>SOUL Staff Actions</h3>
  {{#if this.isLoading}}<p class="text-muted">Working…</p>{{/if}}
  {{#if this.error}}<div class="alert alert-danger">{{this.error}}</div>{{/if}}
  {{#if this.successMessage}}<div class="alert alert-success">{{this.successMessage}}</div>{{/if}}

  <details class="mb-3"><summary>Adjust Skill or Aspect</summary>
    <p class="text-muted">Correct this character's rating. A reason is required and the change is recorded.</p>
    <PowerSelect @selected={{this.frameworkEntry}} @options={{this.frameworkOptions}}
      @searchField="name" @searchEnabled=true @placeholder="Select a Skill or Aspect..."
      @onChange={{action "selectFrameworkEntry"}} as |entry|>
      {{entry.name}} <span class="text-muted">({{entry.kind}})</span>
    </PowerSelect>
    <Input @type="number" @value={{this.frameworkRating}} class="form-control my-2" placeholder="New rating" />
    <Input @value={{this.frameworkReason}} class="form-control my-2" placeholder="Reason" />
    <button class="btn btn-warning" type="button" disabled={{not this.frameworkEntry}}
      onclick={{action "correctFramework"}}>Correct</button>
  </details>

  <details class="mb-3"><summary>Audit Log</summary>
    {{#if this.auditResult.entries}}<ul>{{#each this.auditResult.entries as |entry|}}
      <li>{{entry.created_at}} — {{entry.action}} — {{entry.reason}}</li>
    {{/each}}</ul>{{else}}<p class="text-muted">No audit entries.</p>{{/if}}
  </details>

  <details class="mb-3"><summary>Award or Adjust XP</summary>
    <Input @type="number" @value={{this.xpAmount}} class="form-control my-2" placeholder="Amount" />
    <Input @value={{this.xpReason}} class="form-control my-2" placeholder="Reason" />
    <div class="d-flex gap-2 flex-wrap">
      <button class="btn btn-primary" type="button" onclick={{action "xpAward" false}}>Award</button>
      <button class="btn btn-primary" type="button" onclick={{action "xpAward" true}}>Award + Catch-up</button>
      <button class="btn btn-warning" type="button" onclick={{action "xpCorrect" "correction"}}>Add Correction</button>
      <button class="btn btn-warning" type="button" onclick={{action "xpCorrect" "reversal"}}>Reverse XP</button>
    </div>
  </details>

  <details class="mb-3"><summary>Adjust Boons and Banes</summary>
    <PowerSelect @selected={{this.bnbEntry}} @options={{this.characterBnbEntries}}
      @searchField="name" @searchEnabled=true @placeholder="Select an entry..."
      @onChange={{action "selectBnbEntry"}} as |entry|>
      {{entry.name}} [{{entry.tag}}] — {{entry.kind}}, {{entry.level_state}}
      {{if entry.resolved " (resolved)"}}
    </PowerSelect>
    <Input @value={{this.bnbReason}} class="form-control my-2" placeholder="Explanation / reason" />
    <div class="d-flex gap-2 flex-wrap">
      <button class="btn btn-secondary" type="button" disabled={{not this.bnbEntry}}
        onclick={{action "bnbAdjustLevel" "progress"}}>Progress</button>
      <button class="btn btn-secondary" type="button" disabled={{not this.bnbEntry}}
        onclick={{action "bnbAdjustLevel" "regress"}}>Regress</button>
      <button class="btn btn-secondary" type="button" disabled={{not this.bnbEntry}}
        onclick={{action "bnbTransition" "soulBnbResolve"}}>Resolve</button>
      <button class="btn btn-secondary" type="button" disabled={{not this.bnbEntry}}
        onclick={{action "bnbTransition" "soulBnbRestore"}}>Restore</button>
    </div>
    <div class="form-text mb-0">Progress/Regress move a Boon or Bane one step along Minor/Major/Legendary -
      Progress is always the direction that's good for the character (a Boon strengthens, a Bane weakens).</div>
    <div class="form-check mt-3">
      <Input @type="checkbox" @checked={{this.deleteConfirmOne}} class="form-check-input"
        id="soul-delete-confirm-one" />
      <label class="form-check-label" for="soul-delete-confirm-one">
        I understand this permanently deletes the record.
      </label>
    </div>
    <div class="form-check">
      <Input @type="checkbox" @checked={{this.deleteConfirmTwo}} class="form-check-input"
        id="soul-delete-confirm-two" />
      <label class="form-check-label" for="soul-delete-confirm-two">
        I confirm again; resolving or negating is not appropriate.
      </label>
    </div>
    <button class="btn btn-danger mt-2" type="button"
      disabled={{not (and this.bnbEntry this.deleteConfirmOne this.deleteConfirmTwo)}}
      onclick={{action "bnbTransition" "soulBnbDelete"}}>Permanently Delete</button>

    <hr>
    <p class="mb-1"><strong>Add/Remove</strong></p>
    <p class="text-muted mb-1">Grant a new Boon or Bane</p>
    <PowerSelect @selected={{this.bnbCatalogueEntry}} @options={{this.catalogueEntries}}
      @searchField="name" @searchEnabled=true @placeholder="Select a Boon/Bane..."
      @onChange={{action "selectBnbCatalogue"}} as |entry|>
      {{entry.name}} [{{entry.tag}}] — {{entry.kind}}
    </PowerSelect>
    <select class="form-select my-2" aria-label="Boon or Bane level"
      onchange={{action (mut this.bnbLevel) value="target.value"}}>
      <option value="minor">Minor</option>
      <option value="major">Major</option>
      <option value="legendary">Legendary</option>
    </select>
    {{#unless this.bnbCatalogueEntry.has_fixed_skills}}
      <PowerSelectMultiple @selected={{this.bnbSkills}} @options={{this.availableSkills}}
        @searchField="name" @searchEnabled=true @placeholder="Select Skill(s)..."
        @onChange={{action "selectBnbSkills"}} as |skill|>
        {{skill.name}}
      </PowerSelectMultiple>
    {{/unless}}
    <Input @value={{this.bnbExplanation}} class="form-control my-2" placeholder="Explanation" />
    <button class="btn btn-primary" type="button" onclick={{action "bnbGrant"}}>Grant</button>
  </details>

  <details>
    <summary>Culminations</summary>

    <p class="text-muted mb-1">Propose a new Culmination</p>
    <Input @value={{this.culminationTitle}} class="form-control my-2" placeholder="Title" />
    <Textarea @value={{this.culminationDescription}} class="form-control my-2" placeholder="Description" />
    <button class="btn btn-primary" type="button" onclick={{action "culminationPropose"}}>Propose</button>

    <p class="text-muted mb-1 mt-3">Manage an existing Culmination</p>
    <PowerSelect @selected={{this.culminationEntry}} @options={{this.culminations}}
      @searchField="title" @searchEnabled=true @placeholder="Select a Culmination..."
      @onChange={{action "selectCulminationEntry"}} as |culmination|>
      {{culmination.title}} — {{culmination.status}}
    </PowerSelect>
    <Input @value={{this.culminationReason}} class="form-control my-2" placeholder="Reason (required to deny/revoke/correct)" />
    <div class="form-text mb-0">Only needed for Correct - leave blank to keep the existing title/description.</div>
    <Input @value={{this.culminationCorrectTitle}} class="form-control my-2" placeholder="New title (Correct only)" />
    <Textarea @value={{this.culminationCorrectDescription}} class="form-control my-2" placeholder="New description (Correct only)" />
    <div class="d-flex gap-2 flex-wrap">
      <button class="btn btn-success" type="button" disabled={{not this.culminationEntry}}
        onclick={{action "culminationManage" "soulCulminationApprove"}}>Approve</button>
      <button class="btn btn-secondary" type="button" disabled={{not this.culminationEntry}}
        onclick={{action "culminationManage" "soulCulminationDeny"}}>Deny</button>
      <button class="btn btn-secondary" type="button" disabled={{not this.culminationEntry}}
        onclick={{action "culminationManage" "soulCulminationRevoke"}}>Revoke</button>
      <button class="btn btn-warning" type="button" disabled={{not this.culminationEntry}}
        onclick={{action "culminationManage" "soulCulminationCorrect"}}>Correct</button>
    </div>
  </details>
</section>
