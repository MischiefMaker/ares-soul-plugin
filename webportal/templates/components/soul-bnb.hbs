<section class="soul-bnb card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong>Boons &amp; Banes</strong>
    {{#if this.isSelf}}
      <button type="button" class="btn btn-sm btn-outline-primary soul-bnb-add" title="Add a Boon or Bane"
        onclick={{action "openPicker"}}>+</button>
    {{/if}}
  </div>

  {{#if this.isLoading}}
    <div class="card-body text-muted">Loading…</div>
  {{else}}
    {{#if this.entries.length}}
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead>
            <tr>
              <th scope="col">Entry</th><th scope="col">Kind</th><th scope="col">Level</th>
              <th scope="col">Skills</th><th scope="col">State</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.entries as |entry|}}
              <tr class="soul-bnb-row" role="button" tabindex="0" onclick={{action "showDetail" entry}}>
                <td>{{entry.name}} <span class="text-muted">[{{entry.tag}}]</span></td>
                <td>{{entry.kind}}</td>
                <td>{{entry.level_state}}</td>
                <td>{{if entry.skills.length entry.skills "—"}}</td>
                <td>{{if entry.resolved "Resolved" "Active"}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="card-body text-muted">No Boons or Banes recorded.</div>
    {{/if}}

    {{#if this.requests.length}}
      <div class="card-body border-top">
        <h6>Pending &amp; Recent Requests</h6>
        <ul class="list-unstyled mb-0">
          {{#each this.requests as |req|}}
            <li class="soul-bnb-request mb-2">
              [{{req.tag}}] {{req.name}} ({{req.level_state}}) -
              <span class="badge {{if (eq req.status "denied") "bg-danger" "bg-secondary"}}">{{req.status}}</span>
              {{#if req.staff_reason}}<div class="text-muted small">{{req.staff_reason}}</div>{{/if}}
            </li>
          {{/each}}
        </ul>
      </div>
    {{/if}}
  {{/if}}
</section>

<BsModalSimple
  @title={{if this.detailEntry.name this.detailEntry.name "Boon/Bane Detail"}}
  @closeTitle="Close"
  @submitTitle={{null}}
  @open={{this.detailOpen}}
  @onHide={{action "closeDetail"}}
>
  {{#if this.detailEntry}}
    <p>
      <strong>Tag:</strong> {{this.detailEntry.tag}}
      <span class="ms-3"><strong>Kind:</strong> {{this.detailEntry.kind}}</span>
      <span class="ms-3"><strong>Level:</strong> {{this.detailEntry.level_state}}</span>
      <span class="ms-3"><strong>State:</strong> {{if this.detailEntry.resolved "Resolved" "Active"}}</span>
    </p>
    <p><strong>Skills:</strong> {{if this.detailEntry.skills.length this.detailEntry.skills "None"}}</p>
    <hr>
    <p><strong>Explanation:</strong></p>
    <p>{{if this.detailEntry.explanation this.detailEntry.explanation "None recorded."}}</p>
  {{/if}}
</BsModalSimple>

<BsModalSimple
  @title={{if this.selectedCatalogueEntry.name "Request a Boon/Bane" "Add a Boon/Bane"}}
  @closeTitle="Close"
  @submitTitle={{null}}
  @open={{this.pickerOpen}}
  @onHide={{action "closePicker"}}
>
  {{#if this.selectedCatalogueEntry}}
    <button type="button" class="btn btn-sm btn-link ps-0" onclick={{action "backToList"}}>&laquo; Back to list</button>
    <h5>{{this.selectedCatalogueEntry.name}} <span class="text-muted">[{{this.selectedCatalogueEntry.tag}}]</span></h5>
    <p>{{this.selectedCatalogueEntry.description}}</p>
    {{#if this.requestError}}<div class="alert alert-danger">{{this.requestError}}</div>{{/if}}
    <div class="mb-2">
      <label class="form-label">Level</label>
      <select class="form-select" aria-label="Boon or Bane level"
        onchange={{action (mut this.requestLevel) value="target.value"}}>
        <option value="minor">Minor</option>
        <option value="major">Major</option>
        <option value="legendary">Legendary</option>
      </select>
    </div>
    {{#unless this.selectedCatalogueEntry.has_fixed_skills}}
      <div class="mb-2">
        <label class="form-label">Associated Skill(s)</label>
        <PowerSelectMultiple
          @selected={{this.requestSkills}}
          @options={{this.availableSkills}}
          @searchField="name"
          @searchEnabled=true
          @placeholder="Select Skill(s)..."
          @onChange={{action "selectRequestSkills"}}
          as |skill|
        >
          {{skill.name}}
        </PowerSelectMultiple>
      </div>
    {{/unless}}
    <div class="mb-2">
      <label class="form-label">Why does your character have this?</label>
      <Textarea @value={{this.requestExplanation}} class="form-control" />
    </div>
    <button type="button" class="btn btn-primary"
      disabled={{or this.isSubmitting
        (and (not this.selectedCatalogueEntry.has_fixed_skills) (not this.requestSkills.length))}}
      onclick={{action "submitRequest"}}>Submit Request</button>
  {{else}}
    <div class="input-group mb-3">
      <Input @value={{this.query}} class="form-control" placeholder="Search by name or tag" />
      <button type="button" class="btn btn-secondary" onclick={{action "search"}}>Search</button>
    </div>
    {{#if this.catalogueLoading}}
      <div class="text-muted">Loading…</div>
    {{else}}
      <details class="mb-2">
        <summary>Boons ({{this.boonEntries.length}})</summary>
        <div class="list-group mt-2">
          {{#each this.boonEntries as |entry|}}
            <button type="button" class="list-group-item list-group-item-action soul-bnb-catalogue-entry"
              onclick={{action "pick" entry}}>
              <h6 class="mb-1">[{{entry.tag}}] {{entry.name}}</h6>
              <p class="mb-0 small">{{entry.description}}</p>
            </button>
          {{else}}
            <div class="text-muted small p-2">No Boons found.</div>
          {{/each}}
        </div>
      </details>
      <details>
        <summary>Banes ({{this.baneEntries.length}})</summary>
        <div class="list-group mt-2">
          {{#each this.baneEntries as |entry|}}
            <button type="button" class="list-group-item list-group-item-action soul-bnb-catalogue-entry"
              onclick={{action "pick" entry}}>
              <h6 class="mb-1">[{{entry.tag}}] {{entry.name}}</h6>
              <p class="mb-0 small">{{entry.description}}</p>
            </button>
          {{else}}
            <div class="text-muted small p-2">No Banes found.</div>
          {{/each}}
        </div>
      </details>
    {{/if}}
  {{/if}}
</BsModalSimple>
