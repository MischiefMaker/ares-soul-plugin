{{#if this.canUseTools}}
<li class="soul-scene-tools-nav-item">
  <button type="button" class="dropdown-item" onclick={{action "openTools"}}>
    SOUL Scene Tools
  </button>
</li>

<BsModalSimple
  @title="SOUL Scene Tools"
  @closeTitle="Close"
  @submitTitle={{null}}
  @size="lg"
  @fade={{true}}
  @open={{this.toolsOpen}}
  @onHide={{action "closeTools"}}
>
  <h4>Find a Boon or Bane Here</h4>
  <div class="input-group mb-3">
    <PowerSelect @selected={{this.bnbReference}} @options={{this.catalogueEntries}}
      @searchField="name" @searchEnabled=true @placeholder="Select a Boon/Bane..."
      @onChange={{action "selectBnbReference"}} as |entry|>
      {{entry.name}} [{{entry.tag}}] — {{entry.kind}}
    </PowerSelect>
    <button type="button" class="btn btn-secondary" disabled={{not this.bnbReference}}
      onclick={{action "lookupBnb"}}>Look Up</button>
  </div>
  <ul>{{#each this.bnbMatches as |match|}}
    <li>{{match.character}} — {{match.name}} ({{match.level_state}})</li>
  {{/each}}</ul>

  {{#if this.canViewSheets}}
    <hr><h4>View Participant Sheet</h4>
    <PowerSelect @selected={{this.selectedParticipant}} @options={{this.scene.participants}}
      @searchField="name" @onChange={{action "selectParticipant"}} as |participant|>
      {{participant.name}}
    </PowerSelect>
    <button type="button" class="btn btn-secondary mt-2"
      disabled={{not this.selectedParticipant}} onclick={{action "viewSheet"}}>View Sheet</button>
    {{#if this.participantSheet}}
      <h5 class="mt-3">{{this.participantSheet.character}}</h5>
      {{#each this.participantSheet.aspects as |aspect|}}
        <p><strong>{{aspect.name}} {{aspect.rating}}</strong>:
          {{#each aspect.skills as |skill|}}{{skill.name}} {{skill.rating}}; {{/each}}</p>
      {{/each}}
    {{/if}}
  {{/if}}
</BsModalSimple>
{{/if}}
